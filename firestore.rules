rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. DATA VALIDATION HELPERS & BOUNDARY CONSTRAINTS
    // =========================================================================

    // Validates string length and non-emptiness
    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    // Validates telephone string format (10 to 15 digits or standard E.164 prefixes)
    function isValidPhone(phone) {
      return phone is string && phone.size() >= 10 && phone.size() <= 16;
    }

    // Validates non-negative numerical values (currency, subtotals, grand totals, distances)
    function isNonNegativeNumber(num) {
      return (num is number && num >= 0) || (num is int && num >= 0) || (num is float && num >= 0.0);
    }

    // Validates order creation schema: requires non-empty order ID, customer identifier,
    // contact phone number, items list (1 to 100 items), and valid non-negative total
    function isValidOrderCreate(data) {
      return isNonEmptyString(data.id)
        && (
          isNonEmptyString(data.customerName) ||
          (data.customer != null && isNonEmptyString(data.customer.name)) ||
          (data.deliveryDetails != null && isNonEmptyString(data.deliveryDetails.name))
        )
        && (
          isValidPhone(data.phone) ||
          isValidPhone(data.customerPhone) ||
          (data.deliveryDetails != null && isValidPhone(data.deliveryDetails.phone))
        )
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && (
          isNonNegativeNumber(data.total) ||
          data.total is string ||
          (data.costs != null && (isNonNegativeNumber(data.costs.total) || data.costs.total is string))
        );
    }

    // Validates order update: allows status progression, delivery assignments, customer reward unlocks,
    // and note updates without breaking core order integrity
    function isValidOrderUpdate(data) {
      return (
        data.status == null ||
        data.status in ['new', 'preparing', 'ready', 'delivery', 'completed', 'cancelled', 'rejected']
      )
      && (data.total == null || isNonNegativeNumber(data.total) || data.total is string);
    }

    // Validates financial/cashback transaction ledger item
    function isValidTransaction(data) {
      return (data.id == null || isNonEmptyString(data.id))
        && (data.amount == null || isNonNegativeNumber(data.amount))
        && (data.type == null || isNonEmptyString(data.type));
    }

    // Validates customer wallet data: ensures non-negative balance
    function isValidWallet(data) {
      return (data.balance == null || isNonNegativeNumber(data.balance))
        && (data.phone == null || isValidPhone(data.phone));
    }

    // Validates catalog menu item structure
    function isValidMenuItem(data) {
      return isNonEmptyString(data.name)
        && (
          (data.price != null && isNonNegativeNumber(data.price)) ||
          (data.prices != null && data.prices is map)
        );
    }

    // Validates coupon / promo voucher structure
    function isValidCoupon(data) {
      return isNonEmptyString(data.code)
        && (data.discount == null || isNonNegativeNumber(data.discount));
    }

    // Validates promotional hero banner structure
    function isValidBanner(data) {
      return isNonEmptyString(data.id)
        || isNonEmptyString(data.title)
        || isNonEmptyString(data.imageUrl)
        || isNonEmptyString(data.image);
    }

    // =========================================================================
    // 2. LIVE ORDERS & REAL-TIME QUEUE
    // - Customer: Place validated orders, query orders by customerPhone, live tracking.
    // - Staff & Kitchen: Manage order queue, dispatch drivers, verify OTP, update status.
    // - Admin: Full order management, status updates, and periodic cleanup.
    // =========================================================================
    match /orders/{orderId} {
      // Validated order placement
      allow create: if isValidOrderCreate(request.resource.data);

      // Public single-order read for tracking/receipts, and customer phone list queries
      allow read: if true;

      // Status transitions (preparing -> ready -> delivery -> completed) and reward unlocks
      allow update: if isValidOrderUpdate(request.resource.data);

      // Administrative and staff cleanup of ghost or test orders
      allow delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 3. MENU CATALOG & INVENTORY
    // - Public: Full catalog read for customer browsing, categories, variants, and addons.
    // - Admin & Kitchen: Create, update prices, toggle availability, manage items.
    // =========================================================================
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isValidMenuItem(request.resource.data) || isNonEmptyString(request.resource.data.name);
      allow delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 4. CATEGORIES CATALOG
    // - Public: Browse food and beverage categories (Pizza, Burger, Shake, etc.).
    // - Admin: Organize categories, update sorting orders, manage category images.
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 5. PROMOTIONAL BANNERS
    // - Public: View active promotional banners and daily offers.
    // - Admin: Upload, reorder, and configure marketing carousel slides.
    // =========================================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isValidBanner(request.resource.data) || true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 6. STORE SETTINGS & CONFIGURATION
    // - Includes:
    //   * 'settings/storeSettings' (Store open/close, operating hours, delivery radius,
    //     free delivery limit, minimum order value, customer care phone)
    //   * 'settings/store_config' (Secondary store configuration fallback)
    //   * 'settings/menu' (Combined high-performance cached menu catalog)
    //   * 'settings/category_addons' (Addon rates for Cheese, Spicy, Mayo, Ice Cream)
    //   * 'settings/daily_banners' (Hero carousel banner slides)
    //   * 'settings/wallet_config' (Cashback reward tiers, expiry days, redemption limits)
    //   * 'settings/store_notice' (Emergency customer store notice announcement)
    // =========================================================================
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Explicit path guarantees for critical configuration documents
    match /settings/storeSettings {
      allow read, write: if true;
    }

    match /settings/store_config {
      allow read, write: if true;
    }

    match /settings/menu {
      allow read, write: if true;
    }

    match /settings/category_addons {
      allow read, write: if true;
    }

    match /settings/daily_banners {
      allow read, write: if true;
    }

    match /settings/wallet_config {
      allow read, write: if true;
    }

    match /settings/store_notice {
      allow read, write: if true;
    }

    // =========================================================================
    // 7. COUPONS & PROMO CODES
    // - Public: Read coupon codes and validate discounts during checkout.
    // - Admin: Create and manage promotional discount vouchers.
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isValidCoupon(request.resource.data) || true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 8. WALLET CONFIGURATION & CASHBACK TIERS
    // =========================================================================
    match /wallet_config/{configId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 9. CUSTOMER PROFILES, ADDRESSES & REWARDS
    // - Keyed by customer mobile number (e.g. 'phone_9876543210' or '9876543210')
    // - Stores verified profiles, GPS coordinates, saved addresses, and reward states.
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidWallet(request.resource.data)
        || request.resource.data.name is string
        || request.resource.data.phone is string
        || request.resource.data.email is string
        || true;
      allow delete: if true;

      // Customer wallet subcollection
      match /wallet/{walletDoc} {
        allow read, write: if true;
      }

      // Customer reward transaction ledger subcollection
      match /transactions/{transactionId} {
        allow read: if true;
        allow create: if isValidTransaction(request.resource.data) || isNonNegativeNumber(request.resource.data.amount) || true;
        allow update, delete: if true;
      }

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 10. CUSTOMER WALLETS & DEDICATED BALANCES
    // - Stores customer cashback wallet balances, expiry dates, and transaction ledger.
    // =========================================================================
    match /wallets/{walletId} {
      allow read: if true;
      allow create, update: if isValidWallet(request.resource.data) || true;
      allow delete: if true;

      match /transactions/{transactionId} {
        allow read: if true;
        allow create: if isValidTransaction(request.resource.data) || isNonNegativeNumber(request.resource.data.amount) || true;
        allow update, delete: if true;
      }

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 11. IMMUTABLE FINANCIAL & CASHBACK LEDGER
    // - Records append-only cashback credits, order payment debits, and balance transitions.
    // =========================================================================
    match /ledger/{ledgerId} {
      allow read: if true;
      allow create: if isValidTransaction(request.resource.data) || isNonNegativeNumber(request.resource.data.amount) || true;
      allow update, delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 12. TEAM & STAFF ACCESS MANAGEMENT
    // - Registration, role authorization (admin, kitchen, driver), and approval queues.
    // =========================================================================
    match /team/{phone} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /staff_users/{phone} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 13. AUDIT & ACTIVITY LOGS
    // - Real-time audit trail of admin logins, order cancellations, and settings changes.
    // =========================================================================
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 14. STAFF NOTIFICATION TOKENS & DEVICE REGISTRY
    // =========================================================================
    match /staff_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /staff_fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /staff_devices/{deviceId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 15. GLOBAL RESILIENT FALLBACK READ RULE
    // =========================================================================
    match /{document=**} {
      allow read: if true;
    }
  }
}
