rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. HELPER FUNCTIONS & VALIDATION
    // =========================================================================

    // Helper: Validates customer order creation data structure and required fields
    function isValidOrderCreate(data) {
      return data.id is string
        && (data.customerName is string || (data.customer != null && data.customer.name is string))
        && (data.phone is string || data.customerPhone is string || (data.deliveryDetails != null && data.deliveryDetails.phone is string))
        && data.items is list
        && data.items.size() > 0
        && (data.total is number || data.total is string || (data.costs != null && data.costs.total != null));
    }

    // =========================================================================
    // 2. LIVE ORDERS & REAL-TIME QUEUE
    // - Public / Customer: Can create new validated orders and track order by ID.
    // - Staff & Admin: Read live queue, update preparation/delivery status, and manage orders.
    // =========================================================================
    match /orders/{orderId} {
      // Anyone can create a new order as long as required fields (id, name, phone, items, total) are valid
      allow create: if isValidOrderCreate(request.resource.data);

      // Public single-order read for live tracking and receipts; staff/admin read queue
      allow read: if true;

      // Updating status (preparing, ready, delivery, completed, rejected)
      allow update: if true;

      // Deleting orders (administrative / midnight maintenance)
      allow delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 3. MENU CATALOG & INVENTORY
    // - Public: Full read access to menu items, categories, pricing, and addon choices.
    // - Admin: Create, update, toggle availability, and delete catalog items.
    // =========================================================================
    match /menu/{itemId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 4. STORE SETTINGS & CONFIGURATION (DAILY BANNERS, STORE SETTINGS, MENU)
    // - Includes:
    //   * 'settings/daily_banners' (Dynamic homepage carousel banners, min 2, max 7)
    //   * 'settings/storeSettings' (Open/closed status, operating hours, delivery radius,
    //     free delivery limits, master delivery OTP, zone charges, customer care)
    //   * 'settings/menu' (Combined cached menu document for single-listener efficiency)
    // - Public / Customer: Full read access for dynamic hero banners and real-time store state.
    // - Admin: Write / update access for dashboard management.
    // =========================================================================
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 5. TEAM & STAFF ACCESS MANAGEMENT
    // - Handles admin/staff phone registration, access requests, approvals, and role updates.
    // =========================================================================
    match /team/{phone} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /staff_users/{phone} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 6. CUSTOMER PROFILES & SAVED ADDRESSES
    // - Stores verified phone numbers, saved delivery coordinates, and customer addresses.
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 7. ACTIVITY & AUDIT LOGS
    // - Real-time audit trail of administrative actions, role changes, banner updates, and OTP usages.
    // =========================================================================
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 8. STAFF PUSH NOTIFICATION (FCM) TOKENS & DEVICES
    // =========================================================================
    match /staff_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /staff_fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /staff_devices/{deviceId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 9. GLOBAL RESILIENT FALLBACK RULE
    // =========================================================================
    match /{document=**} {
      allow read: if true;
    }
  }
}
